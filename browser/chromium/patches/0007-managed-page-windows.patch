+void BrowserView::SetWinmuxManaged(bool managed) {
+  if (winmux_managed_ == managed) {
+    return;
+  }
+  winmux_managed_ = managed;
+  if (initialized_) {
+    InvalidateLayout();
+    DeprecatedLayoutImmediately();
+    GetWidget()->OnSizeConstraintsChanged();
+  }
+}

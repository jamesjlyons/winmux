+
+// Compact presentation must not rewrite the omnibox's real URL or draft.
+TEST_F(OmniboxViewViewsTest, CompactHostPresentation) {
+  omnibox_view()->SetProperty(winmux::kCompactToolbar, true);
+  omnibox_view()->GetFocusManager()->ClearFocus();
+  const struct {
+    const char16_t* url;
+    const char16_t* host;
+  } cases[] = {
+      {u"https://www.docs.example.com/path?q=one#part", u"www.docs.example.com"},
+      {u"http://localhost:8123/path?query#fragment", u"localhost:8123"},
+      {u"https://example.com:443/path", u"example.com"},
+      {u"http://example.com:80/path", u"example.com"},
+      {u"https://[::1]:8443/path", u"[::1]:8443"},
+      {u"https://name:secret@example.com/path", u"example.com"},
+      {u"chrome://settings/privacy", u""},
+      {u"file:///tmp/document.html", u""},
+      {u"about:blank", u""},
+  };
+  for (const auto& entry : cases) {
+    SCOPED_TRACE(base::UTF16ToUTF8(entry.url));
+    UpdateDisplayURL(entry.url);
+    EXPECT_EQ(entry.host, omnibox_view()->GetCompactDisplayHost());
+    EXPECT_EQ(entry.url, omnibox_view()->GetText());
+  }
+  UpdateDisplayURL(u"https://example.com/path");
+  omnibox_view()->SetProperty(winmux::kCompactToolbar, false);
+  EXPECT_TRUE(omnibox_view()->GetCompactDisplayHost().empty());
+}
+
+TEST_F(OmniboxViewViewsTest, CompactHostFocusCopyAndDraft) {
+  const std::u16string full = u"https://docs.example.com/path?q=one#part";
+  location_bar_model()->set_formatted_full_url(full);
+  omnibox_view()->SetProperty(winmux::kCompactToolbar, true);
+  omnibox_view()->GetFocusManager()->ClearFocus();
+  UpdateDisplayURL(full);
+  EXPECT_EQ(u"docs.example.com", omnibox_view()->GetCompactDisplayHost());
+
+  omnibox_view()->SetFocus(/*is_user_initiated=*/true);
+  EXPECT_TRUE(omnibox_view()->GetCompactDisplayHost().empty());
+  EXPECT_EQ(full, omnibox_view()->GetText());
+  EXPECT_TRUE(omnibox_view()->IsSelectAll());
+  GetTextfieldTestApi().ExecuteTextEditCommand(ui::TextEditCommand::COPY);
+  EXPECT_EQ(base::UTF16ToUTF8(full), ui::clipboard_test_util::ReadAsciiText(
+      ui::Clipboard::GetForCurrentThread(), ui::ClipboardBuffer::kCopyPaste,
+      /*data_dst=*/nullptr));
+
+  omnibox_view()->SetUserText(u"unfinished search");
+  omnibox_view()->GetFocusManager()->ClearFocus();
+  EXPECT_TRUE(omnibox_view()->GetCompactDisplayHost().empty());
+  EXPECT_EQ(u"unfinished search", omnibox_view()->GetText());
+  omnibox_view()->RevertAll();
+  EXPECT_EQ(u"docs.example.com", omnibox_view()->GetCompactDisplayHost());
+  UpdateDisplayURL(u"https://next.example.com/new-path");
+  EXPECT_EQ(u"next.example.com", omnibox_view()->GetCompactDisplayHost());
+}

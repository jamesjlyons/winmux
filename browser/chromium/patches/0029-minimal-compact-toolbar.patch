+TEST_F(OmniboxViewViewsTest, CompactHostMouseRevealsFullURL) {
+  const std::u16string full = u"https://www.example.com/path?q=one#part";
+  location_bar_model()->set_formatted_full_url(full);
+  location_bar_model()->set_url(GURL(full));
+  location_bar_model()->set_url_for_display(u"example.com/path?q=one#part");
+  omnibox_controller()->edit_model()->ResetDisplayTexts();
+  omnibox_view()->SetProperty(winmux::kCompactToolbar, true);
+  omnibox_view()->GetFocusManager()->ClearFocus();
+  omnibox_view()->RevertAll();
+  EXPECT_EQ(u"www.example.com", omnibox_view()->GetCompactDisplayHost());
+  omnibox_textfield()->OnMousePressed(CreateMouseEvent(
+      ui::EventType::kMousePressed, gfx::Point(20, 10)));
+  omnibox_textfield()->OnMouseReleased(CreateMouseEvent(
+      ui::EventType::kMouseReleased, gfx::Point(20, 10)));
+  EXPECT_TRUE(omnibox_view()->GetCompactDisplayHost().empty());
+  EXPECT_EQ(full, omnibox_view()->GetText());
+  EXPECT_TRUE(omnibox_view()->IsSelectAll());

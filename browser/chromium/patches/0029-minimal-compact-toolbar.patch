+std::u16string OmniboxViewViews::GetCompactDisplayHost() const {
+  const auto* model = controller()->edit_model();
+  const GURL& url = controller()->client()->GetURL();
+  if (!GetProperty(winmux::kCompactToolbar) || model->has_focus() ||
+      model->user_input_in_progress() || GetText().empty() ||
+      GetText() != model->GetPermanentDisplayText() || !url.is_valid() ||
+      !url.SchemeIsHTTPOrHTTPS()) {
+    return {};
+  }
+
+  // Use Chromium's IDN/spoof-safe formatter and parsed offsets. Preserve all
+  // subdomains, IPv6 brackets and non-default ports; never abbreviate the URL
+  // held by the edit model, clipboard or accessibility tree.
+  url::Parsed parsed;
+  const std::u16string formatted = url_formatter::FormatUrl(
+      url, url_formatter::kFormatUrlOmitDefaults,
+      base::UnescapeRule::NORMAL, &parsed, nullptr, nullptr);
+  if (!parsed.host.is_nonempty()) {
+    return {};
+  }
+  const int end = parsed.port.is_nonempty() ? parsed.port.end() : parsed.host.end();
+  return formatted.substr(parsed.host.begin, end - parsed.host.begin);
+}

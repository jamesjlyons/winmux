+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_WIDGET_COMPOSITING_BOUNDED_PRESENTATION_CALLBACKS_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_WIDGET_COMPOSITING_BOUNDED_PRESENTATION_CALLBACKS_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace blink::internal {
+
+// Keep recent callbacks when a hidden/occluded surface stops presenting. Return
+// expired callbacks to the caller for failure completion AFTER updating the
+// queue, so callbacks may reenter registration without invalidating iterators.
+// Queue supports move-only callbacks and nondecreasing frame tokens.
+template <typename Callback, typename Queue>
+std::vector<Callback> EnqueueBoundedPresentationCallback(
+    uint32_t frame_token,
+    Callback callback,
+    Queue& queue,
+    size_t max_frames,
+    size_t max_callbacks_per_frame) {
+  std::vector<Callback> expired;
+  if (!queue.empty() && queue.back().first == frame_token) {
+    auto& same_frame = queue.back().second;
+    same_frame.push_back(std::move(callback));
+    if (same_frame.size() > max_callbacks_per_frame) {
+      expired.push_back(std::move(same_frame.front()));
+      same_frame.erase(same_frame.begin());
+    }
+  } else {
+    std::vector<Callback> callbacks;
+    callbacks.push_back(std::move(callback));
+    queue.emplace_back(frame_token, std::move(callbacks));
+    if (queue.size() > max_frames) {
+      expired = std::move(queue.front().second);
+      queue.pop_front();
+    }
+  }
+  return expired;
+}
+
+}  // namespace blink::internal
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_WIDGET_COMPOSITING_BOUNDED_PRESENTATION_CALLBACKS_H_

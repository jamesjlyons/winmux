+void URLLoader::ServeWinMuxEmptyScript() {
+  mojo::ScopedDataPipeProducerHandle producer;
+  mojo::ScopedDataPipeConsumerHandle consumer;
+  if (mojo::CreateDataPipe(nullptr, producer, consumer) != MOJO_RESULT_OK) {
+    NotifyCompleted(net::ERR_INSUFFICIENT_RESOURCES); return;
+  }
+  producer.reset();
+  auto head = mojom::URLResponseHead::New();
+  head->mime_type = "application/javascript";
+  head->charset = "utf-8";
+  head->content_length = 0;
+  head->headers = net::HttpResponseHeaders::Builder(net::HttpVersion(1, 1), "200 OK")
+      .AddHeader("Content-Type", "application/javascript")
+      .AddHeader("Content-Length", "0")
+      .AddHeader("Cache-Control", "no-store")
+      .AddHeader("X-Content-Type-Options", "nosniff")
+      .Build();
+  url_loader_client_.Get()->OnReceiveResponse(std::move(head), std::move(consumer), std::nullopt);
+  NotifyCompleted(net::OK);
+}

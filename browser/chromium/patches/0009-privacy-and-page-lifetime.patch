 FmRegistrationTokenUploader::~FmRegistrationTokenUploader() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
 
-  invalidation_listener_->Shutdown();
+  if (listener_started_) {
+    invalidation_listener_->Shutdown();
+  }
+}
+
+void FmRegistrationTokenUploader::MaybeStartInvalidationListener() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (listener_started_) {
+    return;
+  }
+  StopOngoingUpload();
+  auto* client = core_->client();
+  if (!client) {
+    core_observer_ = std::make_unique<CloudPolicyCoreConnectionObserver>(
+        core_, base::BindOnce(
+                   &FmRegistrationTokenUploader::ScheduleInvalidationListenerStart,
+                   weak_factory_.GetWeakPtr()),
+        base::OnceClosure());
+    return;
+  }
+  if (!client->is_registered()) {
+    client_observer_ = std::make_unique<CloudPolicyClientRegistrationObserver>(
+        client, base::BindOnce(
+                    &FmRegistrationTokenUploader::ScheduleInvalidationListenerStart,
+                    weak_factory_.GetWeakPtr()));
+    core_observer_ = std::make_unique<CloudPolicyCoreConnectionObserver>(
+        core_, base::OnceClosure(),
+        base::BindOnce(
+            &FmRegistrationTokenUploader::OnCoreDisconnectedBeforeStart,
+            weak_factory_.GetWeakPtr()));
+    return;
+  }
+  listener_started_ = true;
+  invalidation_listener_->Start(this);
+}
+
+void FmRegistrationTokenUploader::ScheduleInvalidationListenerStart() {
+  // Defer replacing the observer until its callback has returned.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&FmRegistrationTokenUploader::MaybeStartInvalidationListener,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void FmRegistrationTokenUploader::OnCoreDisconnectedBeforeStart() {
+  // The old client is about to be destroyed; stop observing it synchronously.
+  client_observer_.reset();
+  ScheduleInvalidationListenerStart();
 }
 

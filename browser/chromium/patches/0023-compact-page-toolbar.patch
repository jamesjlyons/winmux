+// Apply density to descendants as well as the row so newly added extension and
+// pinned-action buttons adopt it on their next layout pass.
+void SetCompactToolbarDensity(views::View* view, bool compact) {
+  if (view->GetProperty(winmux::kCompactToolbar) != compact) {
+    view->SetProperty(winmux::kCompactToolbar, compact);
+    view->InvalidateLayout();
+  }
+  for (views::View* child : view->children()) {
+    SetCompactToolbarDensity(child, compact);
+  }
+}

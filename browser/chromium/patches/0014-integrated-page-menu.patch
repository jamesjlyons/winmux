 // Override sendEvent to intercept window drag events and allow key events to be
 // forwarded to a toolkit-views menu while it is active, and while still
 // allowing any native subview to retain firstResponder status.
+// The workspace observes only windows it owns. These action notifications
+// distinguish a user zoom from an ordinary tiled frame matching the zoom size.
+- (void)zoom:(id)sender {
+  [NSNotificationCenter.defaultCenter postNotificationName:@"WinMuxWindowWillZoom" object:self];
+  [super zoom:sender];
+  [NSNotificationCenter.defaultCenter postNotificationName:@"WinMuxWindowDidZoom" object:self];
+}
